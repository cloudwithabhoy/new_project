# notification service configuration reference.
# In Kubernetes: all keys are non-secret -> ConfigMap. This service has NO datastore
# and NO secrets.

# --- HTTP ---
PORT=8089
LOG_LEVEL=info                 # debug | info | warn | error

# --- Kafka ---
KAFKA_BROKERS=localhost:9092   # k8s: kafka:9092
KAFKA_TOPIC=order.created
KAFKA_GROUP=notification
NOTIFICATION_BUFFER=100        # ring-buffer size for GET /notifications
