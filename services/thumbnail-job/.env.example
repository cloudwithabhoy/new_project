# thumbnail-job worker configuration reference.
# In Kubernetes: all keys are non-secret -> ConfigMap.

# --- Kafka ---
KAFKA_BROKERS=localhost:9092          # k8s: kafka:9092
KAFKA_TOPIC=thumbnail.requests
KAFKA_GROUP=thumbnail                 # KEDA's consumerGroup must match this

# --- Ops ---
LOG_LEVEL=info                        # debug | info | warn | error
METRICS_PORT=9100                     # /healthz + /metrics (Prometheus scrape)
