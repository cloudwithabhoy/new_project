# payment service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, secret keys -> Secret.

# --- HTTP ---
PORT=8087
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=payment
DB_PASSWORD=payment       # SECRET -> Kubernetes Secret
DB_NAME=payment
DB_SSLMODE=disable        # require for TLS (RDS)

# --- Fault target (mock authorizer behaviour) ---
# off     -> approve every payment (default)
# decline -> persist status "declined" (still returns 201)
# error   -> return HTTP 500 (nothing persisted) — simulate an authorizer outage
# A deterministic hook for chaos/fault demos alongside Istio fault injection.
FAIL_MODE=off
