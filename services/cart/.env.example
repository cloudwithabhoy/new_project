# cart service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, secret keys -> Secret.

# --- HTTP ---
PORT=8085
LOG_LEVEL=info            # debug | info | warn | error

# --- Datastore (Redis) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=           # SECRET -> Kubernetes Secret (may be empty if Redis has no AUTH)
REDIS_DB=0

# --- Downstream services ---
CATALOG_URL=http://localhost:8083   # base URL of the catalog service (k8s Service name in-cluster)
