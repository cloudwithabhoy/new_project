# search service configuration reference.
# In Kubernetes: all keys -> ConfigMap (this service has no secrets of its own).

# --- HTTP ---
PORT=8084
LOG_LEVEL=info                          # debug | info | warn | error

# --- Backing store (Elasticsearch) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Downstream services ---
CATALOG_URL=http://localhost:8083       # source of products for /reindex
