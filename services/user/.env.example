# user service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, DB_PASSWORD -> Secret.

# --- HTTP ---
PORT=8082
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=user_svc
DB_PASSWORD=user_svc      # SECRET -> Kubernetes Secret
DB_NAME=users
DB_SSLMODE=disable        # require for TLS (RDS)
