# recommendation service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, DB_PASSWORD -> Secret.

# --- HTTP ---
PORT=8090
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=recommendation
DB_PASSWORD=recommendation   # SECRET -> Kubernetes Secret
DB_NAME=recommendation
DB_SSLMODE=disable           # require for TLS (RDS)

# --- Kafka (consumes order.created) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=order.created
KAFKA_GROUP=recommendation

# --- A/B variant (Istio canary knob) ---
VARIANT=a                # a = popular overall | b = co-purchased-with product_id
