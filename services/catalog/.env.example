# Catalog service configuration.
# Copy to `.env` for local runs. In Kubernetes these split into:
#   - ConfigMap (non-secret): PORT, LOG_LEVEL, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_SSLMODE
#   - Secret (sensitive):     DB_PASSWORD

# --- Server ---
PORT=8083
LOG_LEVEL=info          # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=catalog
DB_PASSWORD=catalog     # SECRET — never commit a real value
DB_NAME=catalog
DB_SSLMODE=disable      # use 'require' against a TLS-enabled DB (e.g. RDS)
