# api-gateway service configuration reference.
# In Kubernetes: ALL keys are non-secret -> ConfigMap. The gateway holds no
# secrets — it verifies tokens against auth's PUBLIC JWKS, never a private key.

# --- HTTP ---
PORT=8080
LOG_LEVEL=info            # debug | info | warn | error

# --- Upstream services (base URLs; k8s Service names in-cluster) ---
AUTH_URL=http://localhost:8081
USER_URL=http://localhost:8082
CATALOG_URL=http://localhost:8083
SEARCH_URL=http://localhost:8084
CART_URL=http://localhost:8085
ORDER_URL=http://localhost:8086
RECOMMENDATION_URL=http://localhost:8090

# --- JWT verification ---
# The gateway fetches {AUTH_URL}/.well-known/jwks.json and verifies RS256 tokens,
# checking these claims. Must match auth's JWT_ISSUER / JWT_AUDIENCE.
JWT_ISSUER=auth.ecommerce.local
JWT_AUDIENCE=ecommerce
