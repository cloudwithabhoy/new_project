# auth service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, secret keys -> Secret.

# --- HTTP ---
PORT=8081
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=auth
DB_PASSWORD=auth          # SECRET -> Kubernetes Secret
DB_NAME=auth
DB_SSLMODE=disable        # require for TLS (RDS)

# --- Downstream services ---
USER_URL=http://localhost:8082   # base URL of the user service (k8s Service name in-cluster)

# --- JWT signing ---
# RSA private key in PEM (PKCS#1 or PKCS#8). SECRET -> Kubernetes Secret.
# Leave EMPTY for local dev to auto-generate an ephemeral key (NOT for k8s — it
# changes on restart and breaks live tokens + the published JWKS).
# Generate a stable key:  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_PRIVATE_KEY_PEM=
JWT_ISSUER=auth.ecommerce.local
JWT_AUDIENCE=ecommerce
JWT_TTL_MINUTES=60
