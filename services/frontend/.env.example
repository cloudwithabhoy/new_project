# frontend service configuration (all via env vars — no secrets here).

# HTTP listen port.
PORT=3000

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Base URL of the api-gateway. The browser hits this directly, so in a real
# deployment it must be reachable FROM THE USER'S BROWSER (an Ingress/public
# URL), not the in-cluster Service name. For local dev the gateway is on :8080.
API_GATEWAY_URL=http://localhost:8080
