# order service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, secret keys -> Secret.

# --- HTTP ---
PORT=8086
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=order
DB_PASSWORD=order         # SECRET -> Kubernetes Secret
DB_NAME=order
DB_SSLMODE=disable        # require for TLS (RDS)

# --- Downstream services (order is the orchestrator) ---
CART_URL=http://localhost:8085        # cart service base URL
PAYMENT_URL=http://localhost:8087     # payment service base URL
INVENTORY_URL=http://localhost:8088   # inventory service base URL

# --- Kafka (producer of order.created) ---
KAFKA_BROKERS=localhost:9092          # comma-separated list, e.g. kafka:9092
KAFKA_TOPIC=order.created
