# inventory service configuration reference.
# In Kubernetes: non-secret keys -> ConfigMap, DB_PASSWORD -> Secret.

# --- HTTP ---
PORT=8088
LOG_LEVEL=info            # debug | info | warn | error

# --- Database (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=inventory
DB_PASSWORD=inventory     # SECRET -> Kubernetes Secret
DB_NAME=inventory
DB_SSLMODE=disable        # require for TLS (RDS)

# --- Kafka (async consumer of order.created) ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=order.created
KAFKA_GROUP=inventory
